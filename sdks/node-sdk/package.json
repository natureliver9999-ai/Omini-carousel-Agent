{
  "name": "omni-carousel",
  "version": "0.1.0",
  "description": "Node SDK for omni-carousel: native Anthropic, OpenAI and Vercel AI SDK tool definitions, plus a local/remote runner.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@omni-carousel/engine": "0.1.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "ai": ">=5.0.0",
    "openai": ">=4.60.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  }
}
