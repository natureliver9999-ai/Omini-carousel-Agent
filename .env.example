# Output confinement directory (all rendered carousels live inside here)
OMNI_OUTPUT_DIR=./carousels

# HTTP / Remote MCP / REST Facade settings
OMNI_HOST=127.0.0.1
OMNI_PORT=8765
OMNI_PUBLIC_URL=http://127.0.0.1:8765
OMNI_AUTH_TOKEN=
OMNI_SIGNING_SECRET=

# Optional free-tier stock photo providers (engine degrades gracefully without keys)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Renderer backend: auto | resvg | playwright
OMNI_RENDERER=auto
